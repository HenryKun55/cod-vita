+// Messages of the shader compiler while ffp_failed_shader_dump recompiles a failed shader.
+static char ffp_shark_msgs[4096];
+static void ffp_shark_log(const char *msg, shark_log_level level, int line) {
+	size_t n = strlen(ffp_shark_msgs);
+	snprintf(ffp_shark_msgs + n, sizeof(ffp_shark_msgs) - n, "%d: %s\n", line, msg);
 }
 
+// Writes a fragment shader that did not compile, with the compiler's messages, to
+// ux0:data/shader_fail_<n>.txt.
+static void ffp_failed_shader_dump(const char *cache_name, const char *src) {
+	static int count = 0;
+	char path[64];
+	ffp_shark_msgs[0] = 0;
+	shark_install_log_cb(ffp_shark_log);
+	uint32_t size = strlen(src);
+	shark_compile_shader_extended(src, &size, SHARK_FRAGMENT_SHADER, compiler_opts, compiler_fastmath, compiler_fastprecision, compiler_fastint);
+	shark_install_log_cb(NULL);
+	shark_clear_output();
+	sprintf(path, "ux0:data/shader_fail_%d.txt", count++);
+	SceUID f = sceIoOpen(path, SCE_O_WRONLY | SCE_O_CREAT | SCE_O_TRUNC, 0777);
+	if (f >= 0) {
+		sceIoWrite(f, cache_name, strlen(cache_name));
+		sceIoWrite(f, "\n--- messages ---\n", 18);
+		sceIoWrite(f, ffp_shark_msgs, strlen(ffp_shark_msgs));
+		sceIoWrite(f, "--- source ---\n", 15);
+		sceIoWrite(f, src, strlen(src));
+		sceIoClose(f);
+	}
+}
